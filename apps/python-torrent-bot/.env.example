BOT_TOKEN=123456:REPLACE_WITH_TOKEN_FROM_BOTFATHER
# true — FakeTorrentProvider (симуляция); false — реальный QBittorrentProvider, обязателен QBITTORRENT_URL
TEST_MODE=true
# Реальный qBittorrent Web UI (нужен только при TEST_MODE=false); пути видит qBittorrent — NFS/relative его конфига
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
SAVE_PATH_MOVIES=Movies/
SAVE_PATH_TV=TV/
# Отдельная БД torrent_bot в общем Postgres монорепо (создаёт init-db) — design §Documentation
DATABASE_URL=postgresql://postgres:postgres@192.168.1.35:5432/postgres?sslmode=disable
LOG_LEVEL=INFO  # DEBUG|INFO|WARNING|ERROR|CRITICAL
# HTTP API (FEAT-020): только localhost, без аутентификации; API_USER_ID — telegram id владельца API
# 8090: 8080 занят go-api
API_HOST=127.0.0.1
API_PORT=8090
API_USER_ID=1
