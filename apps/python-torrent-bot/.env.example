BOT_TOKEN=123456:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TEST_MODE=true
# Отдельная БД torrent_bot в общем Postgres монорепо (создаёт init-db) — design §Documentation
DATABASE_URL=postgresql://postgres:password@localhost:55000/torrent_bot?sslmode=disable
LOG_LEVEL=INFO  # DEBUG|INFO|WARNING|ERROR|CRITICAL
# HTTP API (FEAT-020): только localhost, без аутентификации; API_USER_ID — telegram id владельца API
# 8090: 8080 занят go-api
API_HOST=127.0.0.1
API_PORT=8090
API_USER_ID=1
